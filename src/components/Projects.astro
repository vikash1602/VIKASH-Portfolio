---
import { projects } from '../data/content';
---

<section
  id="projects"
  class="scroll-mt-24 border-b-4 border-neo-black bg-neo-yellow py-24 md:py-32"
  aria-label="Selected works"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2
      class="text-stroke font-display text-[11vw] font-bold uppercase leading-none tracking-tight sm:text-6xl md:text-7xl lg:text-8xl"
      data-reveal
    >
      {projects.heading}
    </h2>

    <div class="mt-16 grid gap-10 md:grid-cols-2 md:gap-x-10 md:gap-y-16">
      {
        projects.items.map((project, i) => {
          const odd = i % 2 === 1;
          return (
            <div class={odd ? 'md:translate-y-20' : ''}>
              <article
                class="group flex h-full flex-col border-4 border-neo-black bg-white p-4 shadow-hard-md md:p-6"
                data-reveal
                data-tilt
              >
                <div class="border-4 border-neo-black bg-neo-black">
                  <img
                    src={project.image}
                    alt={project.imageAlt}
                    width="1280"
                    height="720"
                    class={`shot-img block aspect-video w-full object-cover ${project.imagePosition === 'top' ? 'object-top' : 'object-center'}`}
                    loading="lazy"
                  />
                </div>

                <h3 class="glitch-hover mt-6 font-display text-2xl font-bold uppercase md:text-3xl">
                  {project.title}
                </h3>

                <p class="mt-3 text-sm leading-relaxed text-neo-black/80">{project.description}</p>

                <ul class="mt-5 flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <li class="bg-neo-black px-2.5 py-1 font-mono text-xs font-bold text-white">
                      {tag}
                    </li>
                  ))}
                </ul>

                {
                  // Link row renders ONLY when a genuine URL exists — projects
                  // without verified links show no buttons at all (no dead
                  // "COMING SOON" states).
                  (project.demo || project.repo) && (
                    <div class="mt-auto flex flex-wrap items-center gap-3 border-t-2 border-neo-black pt-5">
                      {project.demo && (
                        <a
                          href={project.demo}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="border-2 border-neo-black bg-neo-green px-3.5 py-2 font-mono text-xs font-bold tracking-widest shadow-hard-xs transition-transform hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none"
                        >
                          LIVE DEMO <span aria-hidden="true">→</span>
                        </a>
                      )}
                      {project.repo && (
                        <a
                          href={project.repo}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="border-2 border-neo-black bg-neo-blue px-3.5 py-2 font-mono text-xs font-bold tracking-widest text-white shadow-hard-xs transition-transform hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none"
                        >
                          SOURCE CODE <span aria-hidden="true">↗</span>
                        </a>
                      )}
                    </div>
                  )
                }
              </article>
            </div>
          );
        })
      }
    </div>

    <div class="mt-20 flex justify-center md:mt-28" data-reveal>
      <a href={projects.viewAll.href} target="_blank" rel="noopener noreferrer" class="btn bg-neo-black text-neo-white">
        {projects.viewAll.label} <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>
