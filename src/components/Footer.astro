---
import { footer, site } from '../data/content';

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t-8 border-neo-green bg-neo-black text-white">
  <div class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8">
    <div class="grid gap-12 md:grid-cols-4">
      <div>
        <p class="font-display text-3xl font-bold">{footer.brand}</p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-white/60">{footer.tagline}</p>
      </div>

      <nav aria-label="Sitemap">
        <p class="font-mono text-xs font-bold tracking-widest text-neo-green">SITEMAP</p>
        <ul class="mt-4 space-y-2.5">
          {
            footer.sitemap.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="font-mono text-sm font-bold text-white/80 underline-offset-4 hover:text-neo-yellow hover:underline"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="font-mono text-xs font-bold tracking-widest text-neo-green">SOCIALS</p>
        <ul class="mt-4 flex gap-3">
          <li>
            <a
              href={site.github.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub profile"
              class="flex h-11 w-11 items-center justify-center border-2 border-white/30 transition-colors hover:border-neo-black hover:bg-neo-yellow hover:text-neo-black"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.11-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.7 5.38-5.26 5.66.41.36.78 1.05.78 2.13v3.16c0 .31.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
                ></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              href={site.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn profile"
              class="flex h-11 w-11 items-center justify-center border-2 border-white/30 transition-colors hover:border-neo-black hover:bg-neo-yellow hover:text-neo-black"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path
                  d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5ZM.22 8.1h4.56V23H.22V8.1Zm7.44 0h4.37v2.03h.06c.61-1.15 2.1-2.37 4.32-2.37 4.62 0 5.47 3.04 5.47 7v8.24h-4.55v-7.3c0-1.74-.03-3.98-2.42-3.98-2.43 0-2.8 1.9-2.8 3.86V23H7.66V8.1Z"
                ></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              href={`mailto:${site.email}?subject=${encodeURIComponent('Project Inquiry')}`}
              aria-label="Send an email"
              class="flex h-11 w-11 items-center justify-center border-2 border-white/30 transition-colors hover:border-neo-black hover:bg-neo-yellow hover:text-neo-black"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M3 5h18v14H3z"></path><path d="m3 6 9 7 9-7"></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="font-mono text-xs font-bold tracking-widest text-neo-green">SYSTEM</p>
        <ul class="mt-4 space-y-2 font-mono text-xs text-white/60">
          <li class="flex items-center gap-2">
            <span class="inline-block h-2 w-2 bg-neo-green" aria-hidden="true"></span>
            STATUS: ONLINE
          </li>
          <li>NO_COOKIES // NO_TRACKERS</li>
          <li>BUILT_WITH: ASTRO + THREE.JS</li>
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-wrap items-center justify-between gap-3 border-t border-white/15 py-6 font-mono text-xs text-white/60"
    >
      <p>&copy; {year} VIKASH.exe // SYSTEM_END</p>
      <p>FULL_STACK // DEVELOPER</p>
    </div>
  </div>

  <!-- Ghost brand word -->
  <span
    aria-hidden="true"
    class="pointer-events-none absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-[30%] font-display text-[22vw] font-bold whitespace-nowrap text-white opacity-[0.03] select-none"
  >
    {footer.ghostWord}
  </span>
</footer>
