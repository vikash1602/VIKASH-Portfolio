---
/**
 * Floating chat launcher (bottom-right, all pages) + expandable panel.
 * The launcher IS Folio-01, the digital origami mascot. Shares conversation
 * state with the dedicated section via chatbot.ts.
 */
import ChatPanel from './ChatPanel.astro';
import FolioMascot from './FolioMascot.astro';
import { PROFILE } from '../data/chatbotKnowledge';
---

<div id="chat-widget" class="fixed right-3 bottom-3 z-[80] sm:right-4 sm:bottom-4 print:hidden">
  <!-- Panel -->
  <div
    id="chat-panel"
    hidden
    role="dialog"
    aria-label="Folio — portfolio assistant chat"
    class="fixed inset-x-2 bottom-2 z-[85] flex h-[72vh] max-h-[560px] flex-col overflow-hidden border-4 border-neo-black bg-white shadow-hard-md sm:static sm:h-[520px] sm:w-[380px]"
  >
    <!-- Window chrome -->
    <div class="flex items-center justify-between gap-2 border-b-4 border-neo-black bg-neo-black px-3 py-2.5 text-white">
      <p class="flex min-w-0 items-center gap-2 font-mono text-xs font-bold tracking-widest">
        <FolioMascot variant="avatar" class="shrink-0" />
        <span class="inline-block h-2.5 w-2.5 shrink-0 animate-pulse bg-neo-green" aria-hidden="true"></span>
        <span class="truncate">FOLIO.exe // PORTFOLIO ASSISTANT</span>
      </p>
      <button
        type="button"
        data-chat-close
        aria-label="Close chat"
        class="shrink-0 border-2 border-white/40 p-1 leading-none transition-colors hover:bg-neo-red hover:text-neo-black"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19"></path>
        </svg>
      </button>
    </div>
    <ChatPanel variant="widget" />
  </div>

  <!-- Launcher = FOLIO-01 himself -->
  <button
    type="button"
    id="chat-launcher"
    data-cursor-plain
    aria-expanded="false"
    aria-controls="chat-panel"
    class="mt-3 block cursor-pointer border-0 bg-transparent p-0 outline-offset-4"
  >
    <FolioMascot variant="full" />
    <span class="sr-only">Open the portfolio AI assistant — answers questions about {PROFILE.name}</span>
  </button>
</div>

<script is:inline>
  // Pre-module guard: if a visitor clicks Folio before the chat module has
  // bound its listener (rare, but possible on slow connections), remember the
  // intent — initChatbot() opens the panel as soon as it is ready.
  (function () {
    var b = document.getElementById('chat-launcher');
    if (!b) return;
    b.addEventListener(
      'click',
      function () {
        if (!window.__folioReady) b.setAttribute('data-pending-open', '1');
      },
      { once: false },
    );
  })();
</script>
