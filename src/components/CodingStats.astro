---
import { codingStats, site } from '../data/content';
import snapshot from '../data/github-snapshot.json';

const gh = snapshot.user;
const unavailable = snapshot.unavailable || !gh;

const MONTHS = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
let joined = '';
if (gh) {
  const d = new Date(gh.createdAt);
  joined = `${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
}
const snapshotDate = snapshot.fetchedAt.slice(0, 10);

// Contribution heatmap: align the first cell to its weekday so weeks line up.
const HEAT = ['#262626', '#0F5C25', '#1E9C3E', '#2FD957', '#33FF57'];
let leadingBlanks = 0;
let cells: { level: number; title: string }[] = [];
if (snapshot.heatmap?.days?.length) {
  const days = snapshot.heatmap.days;
  leadingBlanks = new Date(days[0].date + 'T00:00:00Z').getUTCDay();
  cells = days.map((d) => ({ level: Math.min(4, Math.max(0, d.level)), title: `${d.date}: ${d.count} contributions` }));
}

const maxLang = snapshot.languages[0]?.repos ?? 1;
const langColors = ['#FBFF48', '#FF70A6', '#3B82F6', '#A855F7', '#FF9F1C'];
---

<section
  id="coding-stats"
  class="scroll-mt-24 border-y-4 border-neo-black bg-neo-black py-24 text-white md:py-32"
  aria-label="Coding stats"
  data-gh-user={site.github.user}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2
      class="font-display text-[11vw] font-bold uppercase leading-none tracking-tight sm:text-6xl md:text-7xl lg:text-8xl"
      data-reveal
    >
      {codingStats.headingWhite}<span class="text-neo-green">{codingStats.headingAccent}</span>
    </h2>

    <div
      class="mt-14 border-4 border-white/20 p-6 md:p-10"
      data-reveal
    >
      <div class="flex flex-wrap items-center justify-between gap-4">
        <p class="font-mono text-sm font-bold tracking-widest text-neo-green">
          &gt;_ GITHUB.COM/{site.github.user.toUpperCase()}
        </p>
        <p class="flex items-center gap-2 font-mono text-xs font-bold tracking-widest text-white/60">
          <span data-gh="snapshot-line">LAST_UPDATED: {snapshotDate}</span>
          <span
            data-gh="live-badge"
            hidden
            class="border border-neo-green px-2 py-0.5 text-neo-green">LIVE</span
          >
        </p>
      </div>

      {
        unavailable ? (
          <p class="mt-8 font-mono text-sm text-white/70">
            $ gh --stats _<br />
            GITHUB_DATA_UNAVAILABLE — live numbers are hidden rather than invented.
          </p>
        ) : (
          <>
            <dl class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
              <div class="border-2 border-white/20 p-5">
                <dt class="font-mono text-[11px] font-bold tracking-widest text-white/60">
                  PUBLIC_REPOS
                </dt>
                <dd class="mt-2 font-display text-4xl font-bold text-neo-green" data-gh="repos">
                  {gh!.publicRepos}
                </dd>
              </div>
              <div class="border-2 border-white/20 p-5">
                <dt class="font-mono text-[11px] font-bold tracking-widest text-white/60">
                  FOLLOWERS
                </dt>
                <dd class="mt-2 font-display text-4xl font-bold text-neo-pink" data-gh="followers">
                  {gh!.followers}
                </dd>
              </div>
              <div class="border-2 border-white/20 p-5">
                <dt class="font-mono text-[11px] font-bold tracking-widest text-white/60">
                  FOLLOWING
                </dt>
                <dd class="mt-2 font-display text-4xl font-bold text-neo-purple" data-gh="following">
                  {gh!.following ?? 0}
                </dd>
              </div>
              <div class="border-2 border-white/20 p-5">
                <dt class="font-mono text-[11px] font-bold tracking-widest text-white/60">JOINED</dt>
                <dd class="mt-2 font-display text-4xl font-bold text-neo-blue">{joined}</dd>
              </div>
            </dl>

            {snapshot.languages.length > 0 && (
              <div class="mt-8">
                <p class="font-mono text-[11px] font-bold tracking-widest text-white/60">
                  TOP_LANGUAGES // BY_REPOS
                </p>
                <ul class="mt-3 space-y-2.5">
                  {snapshot.languages.map((lang, i) => (
                    <li class="flex items-center gap-4">
                      <span class="w-32 shrink-0 font-mono text-xs font-bold uppercase">
                        {lang.name}
                      </span>
                      <span class="h-4 flex-1 border border-white/20">
                        <span
                          class="block h-full"
                          style={`width: ${(lang.repos / maxLang) * 100}%; background: ${langColors[i % langColors.length]}`}
                        />
                      </span>
                      <span class="font-mono text-xs font-bold text-white/60">×{lang.repos}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {cells.length > 0 && (
              <div class="mt-8">
                <p class="font-mono text-[11px] font-bold tracking-widest text-white/60">
                  CONTRIBUTIONS_LAST_YEAR:
                  <span class="text-neo-green">{snapshot.heatmap!.total}</span>
                  <span class="ml-2 font-normal normal-case text-white/40">(snapshot)</span>
                </p>
                <div class="mt-3 overflow-x-auto pb-2" role="img" aria-label={`GitHub contribution heatmap for the last year: ${snapshot.heatmap!.total} contributions.`}>
                  <div
                    class="grid grid-flow-col grid-rows-7 gap-[3px]"
                    style="width: max-content"
                    aria-hidden="true"
                  >
                    {Array.from({ length: leadingBlanks }).map(() => (
                      <span class="h-3 w-3" />
                    ))}
                    {cells.map((cell) => (
                      <span
                        class="h-3 w-3"
                        style={`background: ${HEAT[cell.level]}`}
                        title={cell.title}
                      />
                    ))}
                  </div>
                </div>
              </div>
            )}

            <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t-2 border-white/20 pt-6">
              <p class="font-mono text-sm font-bold text-white/60">$ gh --stats _</p>
              <a
                href={site.github.url}
                class="font-mono text-sm font-bold text-neo-green underline decoration-2 underline-offset-4 hover:bg-neo-green hover:text-neo-black"
              >
                VIEW_GH -&gt;
              </a>
            </div>
          </>
        )
      }
    </div>
  </div>
</section>
