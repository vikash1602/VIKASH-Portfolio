---
/**
 * REPORTS — renders ONLY when real testimonial quotes (with permission) exist
 * in src/data/content.ts. With fewer than 4 quotes the cards are static; with
 * 4+ they run in a looping marquee. Currently zero quotes -> renders nothing
 * and the section is absent from the page (and navigation).
 */
import { reports } from '../data/content';
import ReportCard from './ReportCard.astro';

const quotes = reports.quotes;
const enabled = quotes.length > 0;
const marqueeMode = quotes.length >= 4;

const barColors = ['#FBFF48', '#FF70A6', '#3B82F6', '#33FF57', '#A855F7', '#FF9F1C'];
---

{
  enabled && (
    <section
      id="reports"
      class="scroll-mt-24 border-b-4 border-neo-black bg-neo-black py-24 text-white md:py-32"
      aria-label="Reports"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div
          class="inline-flex items-center gap-3 border-2 border-white/20 bg-neo-black px-4 py-2"
          data-reveal
        >
          <span class="flex gap-1.5" aria-hidden="true">
            <span class="h-3 w-3 rounded-full bg-neo-red" />
            <span class="h-3 w-3 rounded-full bg-neo-yellow" />
            <span class="h-3 w-3 rounded-full bg-neo-green" />
          </span>
          <span class="font-mono text-xs font-bold tracking-widest text-white">USER_REPORTS.txt</span>
          <span class="bg-neo-blue px-2 py-0.5 font-mono text-[11px] font-bold text-white">
            {quotes.length}
          </span>
        </div>
      </div>

      {marqueeMode ? (
        <div class="marquee mt-12" role="marquee" aria-label="Testimonials ticker">
          <div class="marquee-track gap-6 pr-6">
            {[0, 1].map((copy) => (
              <div
                class="flex shrink-0 gap-6"
                aria-hidden={copy === 1 ? 'true' : undefined}
                aria-label={copy === 0 ? 'Testimonial cards' : undefined}
              >
                {quotes.map((q, i) => (
                  <ReportCard
                    index={i}
                    quote={q.quote}
                    name={q.name}
                    org={q.org}
                    year={q.year}
                    rating={q.rating}
                    barColor={barColors[i % barColors.length]}
                  />
                ))}
              </div>
            ))}
          </div>
        </div>
      ) : (
        <div
          class="mx-auto mt-12 flex max-w-7xl flex-wrap justify-center gap-6 px-4 sm:px-6 lg:px-8"
          data-reveal
        >
          {quotes.map((q, i) => (
            <ReportCard
              index={i}
              quote={q.quote}
              name={q.name}
              org={q.org}
              year={q.year}
              rating={q.rating}
              barColor={barColors[i % barColors.length]}
            />
          ))}
        </div>
      )}
    </section>
  )
}
