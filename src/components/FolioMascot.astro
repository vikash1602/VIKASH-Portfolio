---
/**
 * FOLIO-01 — "The Digital Origami Creature".
 * An original character: a folded yellow origami shell with a tiny terminal
 * face, a bookmark-shaped tail, a cursor antenna and one expressive arm.
 * Pure inline SVG + CSS keyframes (transform/opacity only). No images, no
 * libraries. Conversation moods arrive as `folio:mood` CustomEvents from
 * src/scripts/chatbot.ts and are applied as a `data-mood` attribute here.
 *
 * variant="full"   — the animated floating mascot (launcher)
 * variant="avatar" — small static face used inside the chat panel header
 */
interface Props {
  variant?: 'full' | 'avatar';
  class?: string;
}

const { variant = 'full', class: className = '' } = Astro.props;
const isAvatar = variant === 'avatar';
---

{
  isAvatar ? (
    <svg
      class={`folio-avatar ${className}`}
      viewBox="0 0 140 150"
      width="26"
      height="28"
      aria-hidden="true"
    >
      <polygon
        points="28,44 84,34 106,58 100,96 56,110 26,92"
        fill="#FBFF48"
        stroke="#121212"
        stroke-width="7"
        stroke-linejoin="round"
      />
      <rect x="42" y="54" width="54" height="42" rx="7" fill="#FFFDF5" stroke="#121212" stroke-width="5" />
      <rect x="52" y="64" width="9" height="14" rx="3.5" fill="#121212" />
      <rect x="72" y="66" width="12" height="11" rx="3.5" fill="#121212" />
      <path d="M60 90 q7 5 14 0" fill="none" stroke="#121212" stroke-width="4" stroke-linecap="round" />
    </svg>
  ) : (
    <span class={`folio-wrap ${className}`} data-folio-mascot data-mood="idle">
      <!-- Speech bubble (hover / first visit / thinking dots) -->
      <span class="folio-bubble" aria-hidden="true">
        <span class="folio-bubble-text">
          <span class="bubble-long">Hey! I'm Folio. Got a question? I'm all circuits and curiosity!</span>
          <span class="bubble-short">Hi! I'm Folio 👋 Ask me anything!</span>
        </span>
        <span class="folio-bubble-dots" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
      </span>

      <svg
        class="folio-svg"
        viewBox="0 0 140 150"
        width="112"
        height="120"
        aria-hidden="true"
      >
        {/* ------------------------- particles ------------------------- */}
        <g class="particle p-plus">
          <path d="M16 34 h9 M20.5 29.5 v9" stroke="#3B82F6" stroke-width="3" stroke-linecap="square" />
        </g>
        <g class="particle p-square">
          <rect x="118" y="40" width="8" height="8" fill="#FF70A6" stroke="#121212" stroke-width="2.5" />
        </g>
        <g class="particle p-tri">
          <polygon points="20,114 29,114 24.5,105" fill="none" stroke="#121212" stroke-width="2.5" />
        </g>
        <g class="particle p-dot">
          <circle cx="124" cy="114" r="3.5" fill="#3B82F6" />
        </g>
        <g class="sparkle s1">
          <path d="M24 16 h8 M28 12 v8" stroke="#FF70A6" stroke-width="3" stroke-linecap="square" />
        </g>
        <g class="sparkle s2">
          <path d="M116 10 h7 M119.5 6.5 v7" stroke="#3B82F6" stroke-width="3" stroke-linecap="square" />
        </g>

        {/* --------------------- floating character -------------------- */}
        <g class="folio-float">
          {/* cursor antenna (drawn first so the body overlaps its base) */}
          <g class="antenna">
            <path
              d="M74 32 C78 24 86 19 94 16"
              fill="none"
              stroke="#121212"
              stroke-width="3.5"
              stroke-linecap="round"
            />
            <polygon
              points="93,15 111,21 99,27 103,35"
              fill="#3B82F6"
              stroke="#121212"
              stroke-width="3"
              stroke-linejoin="round"
            />
          </g>

          {/* bookmark-shaped tail (signature — peeks from behind) */}
          <g class="tail">
            <polygon
              points="94,86 113,90 111,128 103.5,120.5 96.5,127"
              fill="#FBFF48"
              stroke="#121212"
              stroke-width="4.5"
              stroke-linejoin="round"
            />
            <polygon points="100,94 107,95.5 105.5,116 102.5,112 100,116" fill="#FF70A6" />
          </g>

          {/* folded origami shell: back layer, main shell, creases, flap */}
          <g class="folio-body">
            <polygon
              points="36,52 92,42 113,66 107,104 63,118 33,100"
              fill="#E9E94D"
              stroke="#121212"
              stroke-width="4"
              stroke-linejoin="round"
            />
            <polygon
              points="28,44 84,34 106,58 100,96 56,110 26,92"
              fill="#FBFF48"
              stroke="#121212"
              stroke-width="5"
              stroke-linejoin="round"
            />
            <path
              d="M28 44 L56 67 L84 34 M56 67 L100 96"
              fill="none"
              stroke="#121212"
              stroke-width="2.25"
              opacity="0.55"
            />
            <polygon
              points="26,92 56,110 40,123"
              fill="#FFFDF5"
              stroke="#121212"
              stroke-width="4"
              stroke-linejoin="round"
            />

            {/* terminal face plate */}
            <g class="face-plate">
              <rect x="42" y="54" width="54" height="42" rx="7" fill="#FFFDF5" stroke="#121212" stroke-width="4" />

              {/* eyes: idle pixel rects (asymmetric, independent blink) */}
              <g class="eyes">
                <rect class="eye eye-l" x="52" y="64" width="9" height="14" rx="3.5" fill="#121212" />
                <rect class="eye eye-r" x="72" y="66" width="12" height="11" rx="3.5" fill="#121212" />
                {/* happy arcs */}
                <g class="eye-happy">
                  <path d="M52 74 q4.5 -7.5 9 0" fill="none" stroke="#121212" stroke-width="4" stroke-linecap="round" />
                  <path d="M72 72 q6 -7.5 12 0" fill="none" stroke="#121212" stroke-width="4" stroke-linecap="round" />
                </g>
                {/* concerned slants */}
                <g class="eye-error">
                  <path d="M52 65 L61 74" fill="none" stroke="#121212" stroke-width="4" stroke-linecap="round" />
                  <path d="M84 65 L73 74" fill="none" stroke="#121212" stroke-width="4" stroke-linecap="round" />
                </g>
              </g>

              {/* mouth variants */}
              <g class="mouths">
                <path class="mouth-idle" d="M60 89 q7 5.5 14 0" fill="none" stroke="#121212" stroke-width="3.5" stroke-linecap="round" />
                <path class="mouth-happy" d="M57 87.5 q10 8 20 0" fill="none" stroke="#121212" stroke-width="4" stroke-linecap="round" />
                <path class="mouth-error" d="M60 93 q7 -5.5 14 0" fill="none" stroke="#121212" stroke-width="3.5" stroke-linecap="round" />
                <ellipse class="mouth-o" cx="67" cy="91" rx="4.5" ry="3" fill="#121212" />
                <ellipse class="mouth-talk" cx="67" cy="91" rx="5.5" ry="4" fill="#121212" />
              </g>
            </g>

            {/* one expressive arm (right side) */}
            <g class="arm">
              <rect x="100" y="70" width="17" height="9" rx="4.5" fill="#FBFF48" stroke="#121212" stroke-width="4" />
            </g>
          </g>
        </g>
      </svg>
    </span>
  )
}
---

<style>
  /* ======================================================================
     FOLIO-01 — the Digital Origami Creature
     All motion is transform/opacity only (GPU-cheap, layout-safe).
     Moods come from src/scripts/chatbot.ts via the `data-mood` attribute:
     idle | thinking | talking | happy | error
     ====================================================================== */
  .folio-wrap {
    position: relative;
    display: inline-block;
    line-height: 0;
  }
  .folio-svg {
    display: block;
    width: clamp(72px, 9vw, 116px);
    height: auto;
    overflow: visible;
    transition: transform 0.2s ease-out;
  }

  /* ------------------------------ idle life ------------------------------ */
  .folio-float {
    animation: folio-float 3.4s ease-in-out infinite;
    transform-origin: 70px 75px;
  }
  .eyes {
    animation: folio-look 9s ease-in-out infinite;
  }
  .eye {
    transform-box: fill-box;
    transform-origin: center;
  }
  .eye-l {
    animation: folio-blink 4.6s ease-in-out infinite;
  }
  .eye-r {
    animation: folio-blink 5.8s ease-in-out infinite 0.9s;
  }
  .antenna {
    transform-box: fill-box;
    transform-origin: 10% 95%;
    animation: folio-antenna 3.4s ease-in-out infinite;
  }
  .tail {
    transform-box: fill-box;
    transform-origin: 20% 5%;
    animation: folio-sway 3s ease-in-out infinite;
  }
  .arm {
    transform-box: fill-box;
    transform-origin: 0% 50%;
    animation: folio-arm-idle 3.4s ease-in-out infinite;
  }
  .particle,
  .sparkle {
    transform-box: fill-box;
    transform-origin: center;
  }
  .p-plus {
    animation: folio-drift 4.4s ease-in-out infinite;
  }
  .p-square {
    animation: folio-drift 5.2s ease-in-out infinite 0.7s;
  }
  .p-tri {
    animation: folio-drift 4.8s ease-in-out infinite 1.3s;
  }
  .p-dot {
    animation: folio-drift 5.6s ease-in-out infinite 2s;
  }
  .sparkle {
    opacity: 0;
  }

  @keyframes folio-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }
  @keyframes folio-blink {
    0%,
    91%,
    100% {
      transform: scaleY(1);
    }
    94% {
      transform: scaleY(0.08);
    }
  }
  @keyframes folio-look {
    0%,
    64%,
    100% {
      transform: translate(0, 0);
    }
    72% {
      transform: translate(2.5px, -1px);
    }
    84% {
      transform: translate(-2.5px, 1px);
    }
  }
  @keyframes folio-antenna {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(-5deg);
    }
  }
  @keyframes folio-sway {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(7deg);
    }
  }
  @keyframes folio-arm-idle {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(4deg);
    }
  }
  @keyframes folio-drift {
    0%,
    100% {
      transform: translate(0, 0);
      opacity: 0.9;
    }
    50% {
      transform: translate(2px, -4px);
      opacity: 0.5;
    }
  }

  /* ------------------------------ hover ---------------------------------- */
  .folio-wrap:hover .folio-svg,
  .folio-wrap:focus-visible .folio-svg {
    transform: translate(2px, -3px) scale(1.04);
  }
  .folio-wrap:hover .arm,
  .folio-wrap:focus-visible .arm {
    animation: folio-wave 0.9s ease-in-out;
  }
  @keyframes folio-wave {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-34deg);
    }
    55% {
      transform: rotate(12deg);
    }
    80% {
      transform: rotate(-26deg);
    }
  }

  /* --------------------------- speech bubble ----------------------------- */
  .folio-bubble {
    position: absolute;
    right: calc(100% - 14px);
    bottom: calc(100% - 10px);
    z-index: 5;
    width: max-content;
    max-width: 220px;
    padding: 8px 10px;
    background: var(--color-neo-white, #fffdf5);
    border: 2px solid var(--color-neo-black, #121212);
    box-shadow: 3px 3px 0 #000;
    font-family: var(--font-mono, monospace);
    font-size: 11.5px;
    font-weight: 700;
    line-height: 1.45;
    color: var(--color-neo-black, #121212);
    opacity: 0;
    transform: translateY(6px) scale(0.96);
    transform-origin: 85% 100%;
    pointer-events: none;
    transition:
      opacity 0.18s ease-out,
      transform 0.18s ease-out;
  }
  .folio-bubble::after {
    content: '';
    position: absolute;
    right: 16px;
    bottom: -7px;
    width: 12px;
    height: 12px;
    background: var(--color-neo-white, #fffdf5);
    border-right: 2px solid var(--color-neo-black, #121212);
    border-bottom: 2px solid var(--color-neo-black, #121212);
    transform: rotate(45deg);
  }
  .folio-bubble .bubble-short {
    display: none;
  }
  .folio-bubble-dots {
    display: none;
    gap: 4px;
    padding: 2px 4px;
  }
  .folio-bubble-dots span {
    width: 7px;
    height: 7px;
    background: var(--color-neo-black, #121212);
    animation: folio-dot 1.1s ease-in-out infinite;
  }
  .folio-bubble-dots span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .folio-bubble-dots span:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes folio-dot {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.35;
    }
    30% {
      transform: translateY(-5px);
      opacity: 1;
    }
  }

  /* show bubble on hover (pointer devices) … */
  @media (hover: hover) {
    .folio-wrap:hover .folio-bubble,
    .folio-wrap:focus-visible .folio-bubble {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  /* … or once automatically after the page settles (set by chatbot.ts) */
  .folio-wrap[data-auto-bubble='1'] .folio-bubble {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  /* thinking replaces the text with three dots */
  .folio-wrap[data-mood='thinking'] .folio-bubble {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .folio-wrap[data-mood='thinking'] .folio-bubble-text {
    display: none;
  }
  .folio-wrap[data-mood='thinking'] .folio-bubble-dots {
    display: inline-flex;
  }
  /* mobile: bubble anchors to the left so it never overflows the viewport */
  @media (max-width: 639px) {
    .folio-bubble {
      right: auto;
      left: -60px;
      max-width: 180px;
      transform-origin: 80% 100%;
    }
    .folio-bubble .bubble-long {
      display: none;
    }
    .folio-bubble .bubble-short {
      display: inline;
    }
  }

  /* ============================== MOODS ================================ */
  /* default: hide every special expression */
  .eye-happy,
  .eye-error,
  .mouth-happy,
  .mouth-error,
  .mouth-o,
  .mouth-talk {
    display: none;
  }

  /* THINKING — eyes up-left, one squints, "o" mouth, fast antenna/tail,
     thinking dots in the bubble (above) */
  .folio-wrap[data-mood='thinking'] .eyes {
    animation: folio-look-up 2.4s ease-in-out infinite;
  }
  .folio-wrap[data-mood='thinking'] .eye-r {
    animation: none;
    transform: scaleY(0.45);
  }
  .folio-wrap[data-mood='thinking'] .mouth-idle {
    display: none;
  }
  .folio-wrap[data-mood='thinking'] .mouth-o {
    display: block;
  }
  .folio-wrap[data-mood='thinking'] .antenna {
    animation-duration: 0.9s;
  }
  .folio-wrap[data-mood='thinking'] .tail {
    animation-duration: 0.8s;
  }
  @keyframes folio-look-up {
    0%,
    100% {
      transform: translate(0, -1px);
    }
    50% {
      transform: translate(-2px, -2.5px);
    }
  }

  /* TALKING — mouth pulses while the answer renders */
  .folio-wrap[data-mood='talking'] .mouth-idle {
    display: none;
  }
  .folio-wrap[data-mood='talking'] .mouth-talk {
    display: block;
    transform-box: fill-box;
    transform-origin: center;
    animation: folio-talk 0.42s ease-in-out infinite alternate;
  }
  @keyframes folio-talk {
    from {
      transform: scaleY(0.35);
    }
    to {
      transform: scaleY(1);
    }
  }

  /* HAPPY — arcs, big smile, bounce, sparkles */
  .folio-wrap[data-mood='happy'] .eye-l,
  .folio-wrap[data-mood='happy'] .eye-r {
    display: none;
  }
  .folio-wrap[data-mood='happy'] .eye-happy {
    display: block;
  }
  .folio-wrap[data-mood='happy'] .mouth-idle {
    display: none;
  }
  .folio-wrap[data-mood='happy'] .mouth-happy {
    display: block;
  }
  .folio-wrap[data-mood='happy'] .folio-float {
    animation: folio-bounce 0.62s ease-out 2;
  }
  .folio-wrap[data-mood='happy'] .sparkle {
    animation: folio-sparkle 0.62s ease-out 2;
  }
  @keyframes folio-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    45% {
      transform: translateY(-12px);
    }
  }
  @keyframes folio-sparkle {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.4);
    }
    50% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  /* ERROR — concerned slants, frown, antenna droops, slight tilt */
  .folio-wrap[data-mood='error'] .eye-l,
  .folio-wrap[data-mood='error'] .eye-r {
    display: none;
  }
  .folio-wrap[data-mood='error'] .eye-error {
    display: block;
  }
  .folio-wrap[data-mood='error'] .mouth-idle {
    display: none;
  }
  .folio-wrap[data-mood='error'] .mouth-error {
    display: block;
  }
  .folio-wrap[data-mood='error'] .antenna {
    transform: rotate(16deg);
  }
  .folio-wrap[data-mood='error'] .folio-svg {
    transform: rotate(-2.5deg);
  }

  /* --------------------- reduced motion: stay charming -------------------- */
  @media (prefers-reduced-motion: reduce) {
    .folio-float,
    .eyes,
    .eye,
    .antenna,
    .tail,
    .arm,
    .particle,
    .folio-wrap[data-mood='talking'] .mouth-talk {
      animation: none !important;
    }
    .folio-wrap:hover .folio-svg {
      transform: none;
    }
    .folio-wrap:hover .arm {
      animation: none;
    }
    .folio-bubble,
    .folio-bubble-dots span {
      transition: none;
      animation: none;
    }
  }
</style>

