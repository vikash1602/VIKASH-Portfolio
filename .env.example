# Build & site environment variables — copy to .env.local and fill in what you have.

# --- Site ---
# Final site URL for canonical/OG/sitemap/robots (set after first deploy).
SITE_URL=

# Contact form provider — Formspree (https://formspree.io).
# 1. Create a form at formspree.io → you get an endpoint like:
#      https://formspree.io/f/abcdwxyz
# 2. Paste YOUR endpoint below (the form ID is public — it is not a secret).
# 3. Local testing: put it in .env.local (never committed).
#    Production: add VITE_FORM_ENDPOINT in Vercel → Project → Settings →
#    Environment Variables, then redeploy.
# Without it the form validates and offers the email address as a fallback.
VITE_FORM_ENDPOINT=

# --- Folio AI portfolio assistant (all server-side; never exposed to the browser) ---
# Master switch for the chatbot widget + section + API (true/false, default true).
CHATBOT_ENABLED=true
# LLM provider — Groq free tier only. No paid fallbacks are configured.
LLM_PROVIDER=groq
# Your Groq API key — https://console.groq.com/keys — NEVER commit this file.
GROQ_API_KEY=
# Model id from https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b
# Optional: override the API base URL (used by tests against a mock provider).
GROQ_BASE_URL=

# --- Build-time GitHub stats (optional, avoids API rate limits; build-time only) ---
GITHUB_TOKEN=
